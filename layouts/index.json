{{- /* 全站搜索索引（schema 与 Blowfish 内置一致：title/summary/content/permalink）。
      歌词页的 content 用「去注音原文 + 假名」（来自 lyrics shortcode 写入的页面 Store），
      保证搜「喜び / 笑えない」这类跨注音词的命中质量。 */ -}}
{{- $index := slice -}}
{{- range site.RegularPages -}}
  {{- if not .Params.excludeFromSearch -}}
    {{- $content := .Plain -}}
    {{- $plain := .Store.Get "lyrics-plain" -}}
    {{- if $plain -}}
      {{- $kana := .Store.Get "lyrics-kana" | default "" -}}
      {{- $content = printf "%s\n%s" $plain $kana -}}
    {{- end -}}
    {{- $summary := .Params.description | default "" -}}
    {{- if $plain -}}
      {{- if eq $summary "" -}}
        {{- range $ln := split $plain "\n" -}}
          {{- if and (eq $summary "") (ne (strings.TrimSpace $ln) "") -}}
            {{- $summary = $ln -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- else if eq $summary "" -}}
      {{- $summary = .Summary | plainify | htmlUnescape -}}
    {{- end -}}
    {{- $index = $index | append (dict
      "title"    (.Title | emojify | safeJS)
      "summary"  ($summary | safeJS)
      "content"  ($content | safeJS)
      "permalink" .RelPermalink
    ) -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
